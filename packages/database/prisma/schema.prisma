generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  LISTENER
  ARTIST
  MODERATOR
  FINANCE
  ADMIN
}

enum TrackStatus {
  DRAFT
  UPLOADING
  PROCESSING
  PROCESSING_FAILED
  PENDING_REVIEW
  REJECTED
  SCHEDULED
  PUBLISHED
  TAKEN_DOWN
  ARCHIVED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                         String    @id @default(uuid())
  email                      String    @unique
  passwordHash               String
  username                   String    @unique
  role                       UserRole  @default(LISTENER)
  emailVerified              Boolean   @default(false)
  emailVerificationToken     String?   @unique
  emailVerificationExpiresAt DateTime? @db.Timestamptz()
  passwordResetToken         String?   @unique
  passwordResetExpiresAt     DateTime? @db.Timestamptz()
  mfaEnabled                 Boolean   @default(false)
  mfaSecret                  String?
  createdAt                  DateTime  @default(now()) @db.Timestamptz()
  updatedAt                  DateTime  @updatedAt @db.Timestamptz()

  profile       UserProfile?
  artistProfile ArtistProfile?
  sessions      Session[]
  tracks        Track[]        @relation("ArtistTracks")
  likes         Like[]
  playlists     Playlist[]
  follows       Follow[]       @relation("FollowFollower")
  auditLogs     AuditLog[]
  trackCredits  TrackCredit[]  @relation("TrackCredits")
}

model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String?
  bio         String?
  avatarUrl   String?
  createdAt   DateTime @default(now()) @db.Timestamptz()
  updatedAt   DateTime @updatedAt @db.Timestamptz()

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime @db.Timestamptz()
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz()

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ArtistProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  stageName          String             @unique
  bio                String?
  imageUrl           String?
  isVerified         Boolean            @default(false)
  headerImageUrl     String?
  country            String?
  verifiedAt         DateTime?          @db.Timestamptz()
  websiteUrl         String?
  socialLinks        Json?
  totalFollowers     Int                @default(0)
  totalTracks        Int                @default(0)
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now()) @db.Timestamptz()
  updatedAt          DateTime           @updatedAt @db.Timestamptz()

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks     Track[]
  followers  Follow[] @relation("ArtistFollowers")
}

model Genre {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now()) @db.Timestamptz()

  tracks    Track[]
}

model Track {
  id              String        @id @default(uuid())
  artistProfileId String
  title           String
  slug            String        @unique @default("")
  description     String?
  status          TrackStatus   @default(DRAFT)
  genreId         String?
  durationSeconds Int?
  explicit        Boolean       @default(false)
  releaseDate     DateTime?     @db.Timestamptz()
  playCount       BigInt        @default(0)
  likeCount       Int           @default(0)
  coverImageUrl   String?
  audioUrl        String?
  createdAt       DateTime      @default(now()) @db.Timestamptz()
  updatedAt       DateTime      @updatedAt @db.Timestamptz()

  artistProfile   ArtistProfile  @relation(fields: [artistProfileId], references: [id])
  genre           Genre?         @relation(fields: [genreId], references: [id])
  mediaAssets     MediaAsset[]
  likes           Like[]
  playlistTracks  PlaylistTrack[]
  uploadedBy      User?          @relation("ArtistTracks", fields: [uploadedById], references: [id])
  uploadedById    String?
  credits         TrackCredit[]
}

model TrackCredit {
  id           String   @id @default(uuid())
  trackId      String
  role         String
  name         String
  userId       String?
  createdAt    DateTime @default(now()) @db.Timestamptz()

  track        Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  creditedUser User?    @relation("TrackCredits", fields: [userId], references: [id], onDelete: SetNull)
}

model MediaAsset {
  id            String   @id @default(uuid())
  trackId       String
  assetType     String
  storageKey    String
  mimeType      String
  fileSizeBytes BigInt
  checksum      String
  createdAt     DateTime @default(now()) @db.Timestamptz()

  track         Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
}

model Follow {
  followerId        String
  followingArtistId String
  createdAt         DateTime      @default(now()) @db.Timestamptz()

  follower          User          @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followingArtist   ArtistProfile @relation("ArtistFollowers", fields: [followingArtistId], references: [id], onDelete: Cascade)

  @@id([followerId, followingArtistId])
}

model Like {
  userId    String
  trackId   String
  createdAt DateTime @default(now()) @db.Timestamptz()

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([userId, trackId])
}

model Playlist {
  id            String          @id @default(uuid())
  userId        String
  title         String
  description   String?
  coverImageUrl String?
  trackCount    Int             @default(0)
  isPublic      Boolean         @default(false)
  createdAt     DateTime        @default(now()) @db.Timestamptz()
  updatedAt     DateTime        @updatedAt @db.Timestamptz()

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks        PlaylistTrack[]
}

model PlaylistTrack {
  playlistId String
  trackId    String
  position   Int
  addedAt    DateTime @default(now()) @db.Timestamptz()

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([playlistId, trackId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz()

  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
}
