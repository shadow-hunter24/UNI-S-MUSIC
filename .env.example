NODE_ENV=development

WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/unis_music
REDIS_URL=redis://localhost:6379

SESSION_SECRET=replace_with_a_long_random_secret_min_32_chars

# S3-compatible object storage (Cloudflare R2 or equivalent)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Public base URL for delivered media (CDN)
MEDIA_PUBLIC_BASE_URL=

# Email delivery
EMAIL_PROVIDER=
EMAIL_FROM=

# Payment provider
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=

LOG_LEVEL=debug

JWT_SECRET=replace_with_min_32_char_random_hex
JWT_EXPIRES_IN=15m
THROTTLE_TTL=60
THROTTLE_LIMIT=10
